# =============================================================================
# TrustVault Environment Configuration
# Copy this file to .env and fill in strong credentials.
# NEVER commit the actual .env file.
# =============================================================================

# PostgreSQL Configuration
POSTGRES_DB=trustvault_db
DB_USERNAME=trustvault_app
DB_PASSWORD=replace-with-a-strong-database-password

# Redis Configuration (Used for rate limiting and multi-instance audit coordination)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password

# MinIO / S3 Object Storage Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace-with-minio-admin-access-key
MINIO_SECRET_KEY=replace-with-minio-admin-secret-key
MINIO_BUCKET=trustvault-documents
STORAGE_TYPE=minio

# Local Storage Fallback (Used when STORAGE_TYPE=local)
STORAGE_LOCATION=./trustvault-storage

# Application Security & Seed Settings
SEED_ENABLED=true
DEMO_PASSWORD=TrustVault#2026

# Set to true whenever deployed over HTTPS
SESSION_COOKIE_SECURE=false

# Hibernate Schema Validation (validate for production; Flyway manages DDL)
DDL_AUTO=validate
